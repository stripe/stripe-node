{
  "compilerOptions": {
    "outDir": "./cjs",
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "es2022",
    "lib": [
      "es2022"
    ],
    "alwaysStrict": true,
    "declaration": true,
    "strict": true,
    "strictFunctionTypes": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "types": [
      "node"
    ],
    "sourceMap": false,
    "esModuleInterop": false,
    "skipLibCheck": true
  },
  "include": [
    "./src/**/*"
  ]
}